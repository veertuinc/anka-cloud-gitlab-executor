pipeline {
    agent { node {
            label 'cloud_container_host'
        }
    }
    stages {
        // A final tag greater than the latest GitHub Release publishes as that tag.
        // With no such tag, publish v0.0.0 from edge and replace that GitHub Release.
        // The release name is "v0.0.0 (edge)". It is a prerelease and is not Latest.
        stage('Release') {
            steps {
                withCredentials([
                  string(credentialsId: "AnkaCloudGitlabExecutorGithubToken", variable: 'GITHUB_TOKEN'),
              ]) {
                    script {
                        def releaseTag = sh(script: '''
                            set -eu
                            cp ci/prepare-release.sh /tmp/prepare-release.sh
                            cp ci/select-release-tag.sh /tmp/select-release-tag.sh
                            REPO_ROOT="$PWD" bash /tmp/prepare-release.sh
                        ''', returnStdout: true).trim()
                        if (!(releaseTag ==~ /v[0-9]+\.[0-9]+\.[0-9]+/)) {
                            error("Refusing release tag: ${releaseTag}")
                        }
                        docker.image('goreleaser/goreleaser:latest').inside('--entrypoint "" --env GOCACHE=/tmp/.gocache') {
                            if (releaseTag == 'v0.0.0') {
                                sh '''
                                    set -eu
                                    bash ci/write-edge-goreleaser.sh .goreleaser.yaml /tmp/goreleaser-edge.yaml
                                    echo 'Edge build from branch edge.' > /tmp/edge-notes.md
                                    GORELEASER_CURRENT_TAG=v0.0.0 goreleaser release --clean --config /tmp/goreleaser-edge.yaml --release-notes /tmp/edge-notes.md
                                '''
                            } else {
                                sh "GORELEASER_CURRENT_TAG=${releaseTag} goreleaser release --clean"
                            }
                        }
                    }
              }
            }
        }
    }
    post { always { deleteDir() }}
}
